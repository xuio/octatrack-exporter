{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "checkJs": true,
    "noEmit": true,
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": [],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "src/lib/**/*.js",
    "src/export/**/*.js",
    "src/waveform/**/*.js",
    "src/audio/AudioEngine.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
